<Window x:Class="Jolly64Emu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Jolly64Emu"
        mc:Ignorable="d"
        Title="{Binding MainTitle}" Height="568" Width="1036" KeyDown="OnKeyDown" KeyUp="OnKeyUp" Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Load _PRG..." Click="LoadPrg_Click"/>
                <MenuItem Header="Load _T64..." Click="LoadT64_Click"/>
                <MenuItem Header="Load _D64..." Click="LoadD64_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Screen}" Stretch="Fill"/>

            <TextBlock Text="Executing Assembler" HorizontalAlignment="Left" Margin="15,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="176" Height="16" Grid.Column="1"/>
            <ScrollViewer x:Name="AssemblyScroller"  Grid.Column="1">
                <TextBox IsReadOnly="true" Margin="10,31,15,10" TextWrapping="Wrap" Text="{Binding Path=Assembler}" BorderThickness="3" Background="#FFFFFFE7" TextChanged="ExecutingAssembler_TextChanged"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
